# Copy this file to .env.local and fill in real values.
#
# Supabase itself needs no entry here: `npm run dev` and the test suites all
# boot and configure a local Supabase stack automatically (see README) and
# write their own .env.development.local / .env.test.local.

# Wikimedia Enterprise API credentials, used for article-title redirect
# lookups (src/lib/wikipedia.ts). Sign up at https://enterprise.wikimedia.com/.
WIKIMEDIA_ENTERPRISE_USERNAME=
WIKIMEDIA_ENTERPRISE_PASSWORD=

# Contact info sent in the User-Agent header on every request to
# Wikipedia/Wikimedia's APIs, per their User-Agent policy
# (https://foundation.wikimedia.org/wiki/Policy:Wikimedia_Foundation_User-Agent_Policy).
# Use your own URL/email (not this repo's) so Wikimedia can reach whoever is
# actually running this instance about its traffic.
WIKI_USER_AGENT_CONTACT_URL=
WIKI_USER_AGENT_CONTACT_EMAIL=
